PORT=9100

# La impresora se elige desde pos-frontend > Configuración > Dispositivos (se guarda en config.json,
# generado solo — no lo edites a mano). PRINTER_INTERFACE es solo para el caso avanzado de una
# impresora de red o serial, donde no hay "nombre de impresora Windows" que compartir:
#   Red:    tcp://192.168.1.50:9100
#   Serial: COM3
# Dejalo sin definir para el caso común (impresora térmica USB instalada en Windows).
# PRINTER_INTERFACE=tcp://192.168.1.50:9100

# EPSON o STAR según el modelo de impresora (también seleccionable desde Configuración > Dispositivos)
PRINTER_TYPE=epson

# Orígenes permitidos para llamar a este agente (el pos-frontend)
CORS_ORIGINS=http://localhost:4200
